generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  STAFF
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL_TRANSFER
  ADJUSTMENT
}

enum LedgerReason {
  RECEIPT
  DELIVERY
  INTERNAL_TRANSFER
  ADJUSTMENT
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(STAFF)
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receipts      Receipt[]          @relation("ReceiptCreator")
  deliveries    Delivery[]         @relation("DeliveryCreator")
  transfers     InternalTransfer[] @relation("TransferCreator")
  adjustments   Adjustment[]       @relation("AdjustmentCreator")
  ledgerEntries StockLedgerEntry[]

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id              String                 @id @default(cuid())
  name            String
  sku             String                 @unique
  unitOfMeasure   String
  reorderPoint    Decimal                @default(0) @db.Decimal(18, 3)
  categoryId      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  category        Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockBalances   StockBalance[]
  receiptItems    ReceiptItem[]
  deliveryItems   DeliveryItem[]
  transferItems   InternalTransferItem[]
  adjustmentItems AdjustmentItem[]
  ledgerEntries   StockLedgerEntry[]

  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  address   String?
  createdAt DateTime   @default(now())
  locations Location[]

  @@map("warehouses")
}

model Location {
  id                   String             @id @default(cuid())
  name                 String
  code                 String
  warehouseId          String
  createdAt            DateTime           @default(now())
  warehouse            Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockBalances        StockBalance[]
  receiptItems         ReceiptItem[]
  receipts             Receipt[]          @relation("ReceiptDestination")
  deliveryDocuments    Delivery[]
  transferSources      InternalTransfer[] @relation("TransferSource")
  transferDestinations InternalTransfer[] @relation("TransferDestination")
  adjustmentItems      AdjustmentItem[]
  ledgerEntries        StockLedgerEntry[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("locations")
}

model Receipt {
  id                    String          @id @default(cuid())
  reference             String          @unique
  supplier              String?
  destinationLocationId String
  status                OperationStatus @default(DRAFT)
  createdById           String
  validatedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  destinationLocation   Location        @relation("ReceiptDestination", fields: [destinationLocationId], references: [id])
  createdBy             User            @relation("ReceiptCreator", fields: [createdById], references: [id])
  items                 ReceiptItem[]

  @@index([status])
  @@map("receipts")
}

model ReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String
  productId  String
  locationId String
  quantity   Decimal  @db.Decimal(18, 3)
  receipt    Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@index([receiptId])
  @@map("receipt_items")
}

model Delivery {
  id               String          @id @default(cuid())
  reference        String          @unique
  customer         String?
  sourceLocationId String
  status           OperationStatus @default(DRAFT)
  createdById      String
  validatedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sourceLocation   Location        @relation(fields: [sourceLocationId], references: [id])
  createdBy        User            @relation("DeliveryCreator", fields: [createdById], references: [id])
  items            DeliveryItem[]

  @@index([status])
  @@map("deliveries")
}

model DeliveryItem {
  id         String   @id @default(cuid())
  deliveryId String
  productId  String
  quantity   Decimal  @db.Decimal(18, 3)
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@map("delivery_items")
}

model InternalTransfer {
  id                    String                 @id @default(cuid())
  reference             String                 @unique
  sourceLocationId      String
  destinationLocationId String
  status                OperationStatus        @default(DRAFT)
  createdById           String
  validatedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sourceLocation        Location               @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destinationLocation   Location               @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  createdBy             User                   @relation("TransferCreator", fields: [createdById], references: [id])
  items                 InternalTransferItem[]

  @@index([status])
  @@map("internal_transfers")
}

model InternalTransferItem {
  id         String           @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal          @db.Decimal(18, 3)
  transfer   InternalTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@map("internal_transfer_items")
}

model Adjustment {
  id          String           @id @default(cuid())
  reference   String           @unique
  reason      String?
  status      OperationStatus  @default(DRAFT)
  createdById String
  validatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("AdjustmentCreator", fields: [createdById], references: [id])
  items       AdjustmentItem[]

  @@index([status])
  @@map("adjustments")
}

model AdjustmentItem {
  id              String     @id @default(cuid())
  adjustmentId    String
  productId       String
  locationId      String
  countedQuantity Decimal    @db.Decimal(18, 3)
  adjustment      Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id])
  location        Location   @relation(fields: [locationId], references: [id])

  @@index([adjustmentId])
  @@map("adjustment_items")
}

model StockBalance {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("stock_balances")
}

model StockLedgerEntry {
  id             String        @id @default(cuid())
  productId      String
  locationId     String
  quantityDelta  Decimal       @db.Decimal(18, 3)
  quantityBefore Decimal       @db.Decimal(18, 3)
  quantityAfter  Decimal       @db.Decimal(18, 3)
  reason         LedgerReason
  referenceType  OperationType
  referenceId    String
  note           String?
  createdById    String
  createdAt      DateTime      @default(now())
  product        Product       @relation(fields: [productId], references: [id])
  location       Location      @relation(fields: [locationId], references: [id])
  createdBy      User          @relation(fields: [createdById], references: [id])

  @@index([productId, locationId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_ledger")
}
